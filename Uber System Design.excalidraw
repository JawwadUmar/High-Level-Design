    {
      "id": "CWTMw-yNnUaCvJu426Usb",
      "type": "text",
      "x": 19215.79033541582,
      "y": 5893.85927620187,
      "width": 572.9288003117689,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5J",
      "roundness": null,
      "seed": 2048822282,
      "version": 289,
      "versionNonce": 1838207818,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414234589,
      "created": 1791408432719,
      "link": null,
      "locked": false,
      "text": "No need to keep the\n'RESERVED' status, now that\nwe have DISTRIBUTED LOCK",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No need to keep the 'RESERVED' status, now that we have DISTRIBUTED LOCK",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XoB0AB9NElORud99hqsua",
      "type": "rectangle",
      "x": 17954.638829700074,
      "y": 7222.222032224922,
      "width": 897.6725857030123,
      "height": 577.6833558717098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5K",
      "roundness": {
        "type": 3
      },
      "seed": 994343626,
      "version": 328,
      "versionNonce": 1064343510,
      "isDeleted": true,
      "boundElements": [],
