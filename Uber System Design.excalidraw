      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414234589,
      "created": 1791408432718,
      "link": null,
      "locked": false,
      "text": "When talking about\nDeepDives, focus on Non-\nFucntional Requirements\nand areas of improvement",
