    {
      "id": "YXdoDrYFdtHXTP7JGVKui",
      "type": "text",
      "x": 14511.967163809772,
      "y": 1629.742689773695,
      "width": 572.9288003117689,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2s",
      "roundness": null,
      "seed": 827278922,
      "version": 325,
      "versionNonce": 173646794,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791406518052,
      "created": 1791406247064,
      "link": null,
      "locked": false,
      "text": "No need to keep the\n'RESERVED' status, now that\nwe have DISTRIBUTED LOCK",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No need to keep the 'RESERVED' status, now that we have DISTRIBUTED LOCK",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "P4Yu-mjyVDFwg5pid70j0",
      "type": "rectangle",
      "x": 13250.815658094027,
      "y": 2958.1054457967475,
      "width": 897.6725857030123,
      "height": 577.6833558717098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2t",
      "roundness": {
        "type": 3
      },
      "seed": 954461450,
      "version": 364,
      "versionNonce": 475715030,
      "isDeleted": true,
