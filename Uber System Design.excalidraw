    {
      "id": "lKCXgi6YoEsFBJO2bDt-T",
      "type": "arrow",
      "x": 14019.350997014099,
      "y": 985.6149487599417,
      "width": 159.6593455255006,
      "height": 76.69914419245072,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
