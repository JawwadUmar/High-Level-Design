      "link": null,
      "locked": false,
      "text": "Input a start location and a destination\nand get an estimate.\n\nUser should be to request a ride based on\nthe estimate\n\nDrivers should be able to accept/deny\nrequest and navigative to pickup/driveoff\n\n",
      "fontSize": 37.421840727761115,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Input a start location and a destination and get an estimate.\n\nUser should be to request a ride based on the estimate\n\nDrivers should be able to accept/deny request and navigative to pickup/driveoff\n\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
