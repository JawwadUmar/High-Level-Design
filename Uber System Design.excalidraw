      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "QXBOMHJoOT_q82qlO7zkX",
      "originalText": "Ticket Lock\n(Redis)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2727tZFReEdSzzZaX3B54",
      "type": "rectangle",
      "x": 17983.25886471448,
      "y": 6639.346590027478,
      "width": 839.5078573759172,
      "height": 489.27307531732333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5F",
      "roundness": {
        "type": 3
      },
      "seed": 1997824266,
      "version": 255,
      "versionNonce": 1500273302,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414237387,
      "created": 1791408432719,
      "link": null,
      "locked": false
    },
    {
      "id": "a7JhUk-WZFfLraoJ2jckR",
      "type": "text",
      "x": 18018.01847159802,
      "y": 6674.045766359338,
      "width": 800,
      "height": 414.79902984318846,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5G",
      "roundness": null,
      "seed": 616017866,
      "version": 617,
      "versionNonce": 101499338,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414237387,
      "created": 1791408432719,
      "link": null,
      "locked": false,
      "text": "A cron job will not be able to attain real time\naccuracy. Therefore we will introduce a\nDISTRIBUTED LOCK using REDIS with a\nTTL=10 minutes. So, it will automatically go\naway from the cache after 10 minutes\nTickets in this lock are considered in reserved\nstate\nNow, event search service searches for event\nwith avaialabe ticekts which are not in the\ndistributed lock",
      "fontSize": 33.18392238745508,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A cron job will not be able to attain real time accuracy. Therefore we will introduce a DISTRIBUTED LOCK using REDIS with a TTL=10 minutes. So, it will automatically go away from the cache after 10 minutes\nTickets in this lock are considered in reserved state\nNow, event search service searches for event with avaialabe ticekts which are not in the distributed lock",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "K6wc-NRH6pPLwOwoLGqN3",
      "type": "text",
      "x": 17319.497399947162,
      "y": 6316.473673585783,
      "width": 364.2644166070431,
      "height": 97.74017019540278,
      "angle": 0.6758970762189751,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5H",
      "roundness": null,
      "seed": 1183000202,
      "version": 1732,
      "versionNonce": 824964234,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414234589,
      "created": 1791408432719,
      "link": null,
      "locked": false,
      "text": "Remove those tickets which\nare in lock, as they are in\nreserved state",
      "fontSize": 26.064045385440746,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Remove those tickets which are in lock, as they are in reserved state",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zO8reIHeEqz00VVcFayJ-",
