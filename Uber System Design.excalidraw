    {
      "id": "wVnAyOcvkoiibapHjQwBz",
      "type": "text",
      "x": 10385.944347095163,
      "y": 4227.376397295705,
      "width": 1626.1077872695412,
      "height": 457.3428151695583,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4J",
      "roundness": null,
      "seed": 544103510,
      "version": 324,
      "versionNonce": 749428106,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1791414234589,
      "created": 1791407607514,
      "link": null,
      "locked": false,
      "text": "How to tell users that a particular seat is\nbooked? In case of hot events, the seat\nmay appear available but is actually booked\nand when the user clicks on it, it is a very\nbad user experience!!",
      "fontSize": 73.17485042712933,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to tell users that a particular seat is booked? In case of hot events, the seat may appear available but is actually booked and when the user clicks on it, it is a very bad user experience!!",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RAzDnNgmLN5DGkKCiWnXx",
      "type": "text",
      "x": 10330.908542841396,
      "y": 4814.655284951767,
      "width": 1626.1077872695412,
      "height": 91.46856303391166,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4K",
      "roundness": null,
      "seed": 2025643018,
      "version": 372,
      "versionNonce": 1282054166,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414234589,
      "created": 1791407681543,
      "link": null,
      "locked": false,
      "text": "1. HTTP Long Polling",
      "fontSize": 73.17485042712933,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. HTTP Long Polling",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PVgJI57PJkvrB3OaPgqT1",
      "type": "text",
      "x": 10349.495939692819,
      "y": 4965.678117027774,
      "width": 1626.1077872695412,
      "height": 548.81137820347,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4L",
      "roundness": null,
      "seed": 1400609302,
      "version": 416,
      "versionNonce": 2000362570,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414234589,
      "created": 1791407726846,
      "link": null,
      "locked": false,
      "text": "HTTP long polling is a web communication\ntechnique where the client sends a request\nto the server, and the server holds that\nrequest open until new data is available or a\ntimeout occur. In this case, it is seat/ticket\navailability",
      "fontSize": 73.17485042712933,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP long polling is a web communication technique where the client sends a request to the server, and the server holds that request open until new data is available or a timeout occur. In this case, it is seat/ticket availability",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kWooDUZsLpRaqaNV3x5QF",
