    {
      "id": "jbr6b0wtNSVPDntMtmXwH",
      "type": "text",
      "x": 15146.835337314116,
      "y": 1979.6978570078386,
      "width": 572.9288003117689,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 1008058774,
      "version": 252,
      "versionNonce": 1378000010,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791414234589,
      "created": 1791406518910,
      "link": null,
      "locked": false,
      "text": "No need to keep the\n'RESERVED' status, now that\nwe have DISTRIBUTED LOCK",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No need to keep the 'RESERVED' status, now that we have DISTRIBUTED LOCK",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "extx1JqEfT_0LmL7TQVw7",
      "type": "rectangle",
      "x": 13885.683831598371,
      "y": 3308.060613030891,
      "width": 897.6725857030123,
      "height": 577.6833558717098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
