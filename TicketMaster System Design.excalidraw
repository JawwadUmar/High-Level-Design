    {
      "id": "iLByUNI1ilB4Rio5Ddo3o",
      "type": "text",
      "x": 15595.833696865473,
      "y": 6948.957746756536,
      "width": 14.399993896484375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
