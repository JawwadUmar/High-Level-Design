      "link": null,
      "locked": false,
      "text": "This makes INVERTED INDEXES which makes\nsearching by term superfast.\n\nIt also has support for Geolspatial queries",
      "fontSize": 32.799139564953464,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This makes INVERTED INDEXES which makes searching by term superfast.\n\nIt also has support for Geolspatial queries",
