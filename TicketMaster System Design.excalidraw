      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5G",
      "roundness": null,
      "seed": 616017866,
      "version": 614,
      "versionNonce": 1060453194,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791408434258,
      "created": 1791408432719,
      "link": null,
      "locked": false,
      "text": "A cron job will not be able to attain real time\naccuracy. Therefore we will introduce a\nDISTRIBUTED LOCK using REDIS with a\nTTL=10 minutes. So, it will automatically go\naway from the cache after 10 minutes\nTickets in this lock are considered in reserved\nstate\nNow, event search service searches for event\nwith avaialabe ticekts which are not in the\ndistributed lock",
      "fontSize": 33.18392238745508,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A cron job will not be able to attain real time accuracy. Therefore we will introduce a DISTRIBUTED LOCK using REDIS with a TTL=10 minutes. So, it will automatically go away from the cache after 10 minutes\nTickets in this lock are considered in reserved state\nNow, event search service searches for event with avaialabe ticekts which are not in the distributed lock",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "K6wc-NRH6pPLwOwoLGqN3",
      "type": "text",
      "x": 17319.497399947162,
      "y": 6316.473673585783,
      "width": 364.2644166070431,
      "height": 97.74017019540278,
      "angle": 0.6758970762189751,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5H",
      "roundness": null,
      "seed": 1183000202,
      "version": 1729,
      "versionNonce": 1615020554,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791408434258,
      "created": 1791408432719,
      "link": null,
      "locked": false,
      "text": "Remove those tickets which\nare in lock, as they are in\nreserved state",
      "fontSize": 26.064045385440746,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Remove those tickets which are in lock, as they are in reserved state",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zO8reIHeEqz00VVcFayJ-",
