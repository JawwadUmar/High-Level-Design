    },
    {
      "id": "lIFje2Wp7BRLJ44-m4Sbs",
      "type": "text",
      "x": 13930.274907567235,
      "y": 3365.009268989202,
      "width": 829.8546414012548,
      "height": 452.6953257347492,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3r",
      "roundness": null,
      "seed": 53924886,
      "version": 611,
      "versionNonce": 755921110,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791406546966,
      "created": 1791406518910,
      "link": null,
      "locked": false,
      "text": "WHEN THE LOCK GOES DOWN\nWe will try to immediately bring new lock\nup. But this would mean that any user\nwho has ticket in reserved state for the\nlast 10 minutes, will lose the reservation\n\nPostgres fill follow ACID, so whoever\nwrites first wins. But it is good as we\nare not losing consistency gurantee ",
      "fontSize": 40.23958450975547,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHEN THE LOCK GOES DOWN\nWe will try to immediately bring new lock up. But this would mean that any user who has ticket in reserved state for the last 10 minutes, will lose the reservation\n\nPostgres fill follow ACID, so whoever writes first wins. But it is good as we are not losing consistency gurantee ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
