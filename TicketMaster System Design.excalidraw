    {
      "id": "X8_lehftfzusOBq1czjxX",
      "type": "text",
      "x": 17902.788635360237,
      "y": 5334.999486083581,
      "width": 422.5789259625632,
      "height": 142.62038751236514,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5X",
      "roundness": null,
      "seed": 1159713418,
      "version": 130,
      "versionNonce": 226029066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791408434258,
      "created": 1791408432720,
      "link": null,
      "locked": false,
      "text": "Change Data Capture (CDC) is a software\ndesign pattern used to determine, track, and\ncapture incremental changes (inserts,\nupdates, and deletes) in a data source\n(typically a database) and deliver those\nchanges to downstream systems in real time",
      "fontSize": 19.016051668315338,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Change Data Capture (CDC) is a software design pattern used to determine, track, and capture incremental changes (inserts, updates, and deletes) in a data source (typically a database) and deliver those changes to downstream systems in real time",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
