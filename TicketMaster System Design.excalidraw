    },
    {
      "id": "ornglegx1jp1xr_iRfXrM",
      "type": "text",
      "x": 14221.27331419272,
      "y": 721.2780340439643,
      "width": 800,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b48",
      "roundness": null,
      "seed": 1451292170,
      "version": 323,
      "versionNonce": 1884568586,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791407018150,
      "created": 1791406937472,
      "link": null,
      "locked": false,
      "text": "There is a limit to as to how many writes\ncan be done per second on ElasticSerach, as\nit has an index to update with constant\nwrites. So you can have queue service for\nimplementing your CDC, so elasticsearch can\nconsume at its own rate",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is a limit to as to how many writes can be done per second on ElasticSerach, as it has an index to update with constant writes. So you can have queue service for implementing your CDC, so elasticsearch can consume at its own rate",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FX_D3C9Sx6KwAjkCRuE43",
      "type": "rectangle",
      "x": 10631.039467284276,
      "y": 2191.794162821022,
      "width": 524.106254895407,
      "height": 586.0185936657995,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b49",
      "roundness": {
        "type": 3
      },
      "seed": 284708682,
      "version": 164,
      "versionNonce": 343173078,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "3wKEoyJ4N9MGGp0vUY0qO"
        },
        {
          "id": "WgVHtFEYpPsLv2d-_dwHY",
          "type": "arrow"
        }
      ],
      "updated": 1791407392222,
      "created": 1791407219870,
      "link": null,
      "locked": false
    },
    {
      "id": "3wKEoyJ4N9MGGp0vUY0qO",
      "type": "text",
      "x": 10642.676701177292,
      "y": 2282.303459653922,
      "width": 500.831787109375,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4A",
      "roundness": null,
      "seed": 817697226,
      "version": 369,
      "versionNonce": 1397646614,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791407428958,
      "created": 1791407222018,
      "link": null,
      "locked": false,
      "text": "\nApart from caching static\ncontent, a CDN can cache\nthe API calls along with its\nresponses with a TTL. This\nneeds to be done especially\nif a lot of people are hitting\nthe service with a particular\nsearch term",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FX_D3C9Sx6KwAjkCRuE43",
      "originalText": "\nApart from caching static content, a CDN can cache the API calls along with its responses with a TTL. This needs to be done especially if a lot of people are hitting the service with a particular search term",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
