      "text": "Ticket\nLock\n(Redis)",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Ige6P2ejv8R9msyIKRdLo",
      "originalText": "Ticket Lock\n(Redis)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kLus_OQ1TjuR6JFPI08K0",
      "type": "rectangle",
      "x": 13914.303866612778,
      "y": 2725.1851708334466,
      "width": 839.5078573759172,
      "height": 489.27307531732333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3l",
      "roundness": {
        "type": 3
      },
      "seed": 2120989846,
      "version": 215,
      "versionNonce": 1201400150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791406546966,
      "created": 1791406518910,
      "link": null,
      "locked": false
    },
    {
      "id": "bv5fxXkbNuRkets8d8Yny",
      "type": "text",
      "x": 13949.063473496315,
      "y": 2759.8843471653067,
      "width": 800,
      "height": 414.79902984318846,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3m",
      "roundness": null,
      "seed": 305379798,
      "version": 577,
      "versionNonce": 1178619542,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791406546966,
      "created": 1791406518910,
      "link": null,
      "locked": false,
      "text": "A cron job will not be able to attain real time\naccuracy. Therefore we will introduce a\nDISTRIBUTED LOCK using REDIS with a\nTTL=10 minutes. So, it will automatically go\naway from the cache after 10 minutes\nTickets in this lock are considered in reserved\nstate\nNow, event search service searches for event\nwith avaialabe ticekts which are not in the\ndistributed lock",
      "fontSize": 33.18392238745508,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A cron job will not be able to attain real time accuracy. Therefore we will introduce a DISTRIBUTED LOCK using REDIS with a TTL=10 minutes. So, it will automatically go away from the cache after 10 minutes\nTickets in this lock are considered in reserved state\nNow, event search service searches for event with avaialabe ticekts which are not in the distributed lock",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0-CCpG4Cd-KhXM4xna9Sv",
      "type": "text",
      "x": 13250.54240184546,
      "y": 2402.312254391752,
      "width": 364.2644166070431,
      "height": 97.74017019540278,
      "angle": 0.6758970762189751,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3n",
      "roundness": null,
      "seed": 2122977046,
      "version": 1692,
      "versionNonce": 1436945366,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791406546966,
      "created": 1791406518910,
      "link": null,
      "locked": false,
      "text": "Remove those tickets which\nare in lock, as they are in\nreserved state",
      "fontSize": 26.064045385440746,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Remove those tickets which are in lock, as they are in reserved state",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
