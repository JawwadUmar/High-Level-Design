      "text": "Ticket\nLock\n(Redis)",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "-WCPexm-MTpeJhFPhS8c9",
      "originalText": "Ticket Lock\n(Redis)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "YGowCXS741FYHUaU2nhO4",
      "type": "rectangle",
      "x": 13279.435693108437,
      "y": 2375.230003599303,
      "width": 839.5078573759172,
      "height": 489.27307531732333,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
