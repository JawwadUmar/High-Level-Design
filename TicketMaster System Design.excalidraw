      "index": "b4K",
      "roundness": null,
      "seed": 2025643018,
      "version": 369,
      "versionNonce": 1790909782,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791407719596,
      "created": 1791407681543,
      "link": null,
      "locked": false,
      "text": "1. HTTP Long Polling",
      "fontSize": 73.17485042712933,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. HTTP Long Polling",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PVgJI57PJkvrB3OaPgqT1",
      "type": "text",
      "x": 10349.495939692819,
      "y": 4965.678117027774,
      "width": 1626.1077872695412,
      "height": 548.81137820347,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4L",
      "roundness": null,
      "seed": 1400609302,
      "version": 413,
      "versionNonce": 1027170134,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791407756209,
      "created": 1791407726846,
      "link": null,
      "locked": false,
      "text": "HTTP long polling is a web communication\ntechnique where the client sends a request\nto the server, and the server holds that\nrequest open until new data is available or a\ntimeout occur. In this case, it is seat/ticket\navailability",
      "fontSize": 73.17485042712933,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTTP long polling is a web communication technique where the client sends a request to the server, and the server holds that request open until new data is available or a timeout occur. In this case, it is seat/ticket availability",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kWooDUZsLpRaqaNV3x5QF",
