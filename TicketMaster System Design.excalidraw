    {
      "id": "V-CaVMHoAuGTQZRelinE7",
      "type": "text",
      "x": 10377.3771679175,
      "y": 6129.287390118334,
      "width": 1626.1077872695412,
      "height": 1097.62275640694,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4R",
      "roundness": null,
      "seed": 939129686,
      "version": 661,
      "versionNonce": 157427594,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791408140951,
      "created": 1791407955032,
      "link": null,
      "locked": false,
      "text": "It is also a persistent connection between\nthe client and the server. \nThe only difference between websocket and\nsse is that SSE is uni-directional (server to\nclient)\n\nThe client opens a single, persistent HTTP\nconnection using the browser's native\nEventSource API. The server keeps this\nchannel open and pushes text-based event\nstreams down to the client whenever data\nchanges.",
      "fontSize": 73.17485042712933,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It is also a persistent connection between the client and the server. \nThe only difference between websocket and sse is that SSE is uni-directional (server to client)\n\nThe client opens a single, persistent HTTP connection using the browser's native EventSource API. The server keeps this channel open and pushes text-based event streams down to the client whenever data changes.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
