    {
      "id": "GfavRx8CktNmH1m3DlbZM",
      "type": "text",
      "x": 18290.22831229442,
      "y": 4635.439453237996,
      "width": 800,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5a",
      "roundness": null,
      "seed": 43034314,
      "version": 360,
      "versionNonce": 996504138,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791408434258,
      "created": 1791408432720,
      "link": null,
      "locked": false,
      "text": "There is a limit to as to how many writes\ncan be done per second on ElasticSerach, as\nit has an index to update with constant\nwrites. So you can have queue service for\nimplementing your CDC, so elasticsearch can\nconsume at its own rate",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is a limit to as to how many writes can be done per second on ElasticSerach, as it has an index to update with constant writes. So you can have queue service for implementing your CDC, so elasticsearch can consume at its own rate",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "37yqvBVoftFm2lzw0_koW",
      "type": "rectangle",
      "x": 14044.83053301351,
      "y": 6110.0250167354225,
      "width": 524.106254895407,
      "height": 586.0185936657995,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5b",
      "roundness": {
        "type": 3
      },
      "seed": 203767178,
      "version": 276,
      "versionNonce": 1067784394,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "027ixd6MPJmQJEwk8fa2Z"
        },
        {
          "id": "bcWHfw4cibZeAakTJUrEw",
          "type": "arrow"
        }
      ],
      "updated": 1791408451708,
      "created": 1791408432720,
      "link": null,
      "locked": false
    },
    {
      "id": "027ixd6MPJmQJEwk8fa2Z",
      "type": "text",
      "x": 14056.467766906526,
      "y": 6200.534313568322,
      "width": 500.831787109375,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5c",
      "roundness": null,
      "seed": 209255498,
      "version": 481,
      "versionNonce": 1373335434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791408451708,
      "created": 1791408432720,
      "link": null,
      "locked": false,
      "text": "\nApart from caching static\ncontent, a CDN can cache\nthe API calls along with its\nresponses with a TTL. This\nneeds to be done especially\nif a lot of people are hitting\nthe service with a particular\nsearch term",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "37yqvBVoftFm2lzw0_koW",
      "originalText": "\nApart from caching static content, a CDN can cache the API calls along with its responses with a TTL. This needs to be done especially if a lot of people are hitting the service with a particular search term",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
