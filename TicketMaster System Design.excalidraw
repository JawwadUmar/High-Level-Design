    {
      "id": "LJGsZk-fPekj3xYLSedXi",
      "type": "text",
      "x": 15451.657483799885,
      "y": 6885.925937791945,
      "width": 800,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5o",
      "roundness": null,
      "seed": 79843338,
      "version": 861,
      "versionNonce": 1320173718,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791408749059,
      "created": 1791408539980,
      "link": null,
      "locked": false,
      "text": "This virtual waiting queue may be enabled for\nletting users have a better experience in\ncase the event is really popular. It could be\nsomething that can be turned on and off by\nthe admin. \nAs long as the people are in this queue, they\nmight be getting message like : \"You are in\nqueue, thanks for patience\". This particular\nmessage can be sent using the SSE we\ntalked about.\nThe queue can have logic to let 100 people\nenter at a time and have their tickets\nbooked and then let another 100 come in. \nThe 100 people can be selected randomly\nwhich gives a more fair chance to everyone\nrather than applying FCFS. This queue can\nbe implemted using REDIS\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This virtual waiting queue may be enabled for letting users have a better experience in case the event is really popular. It could be something that can be turned on and off by the admin. \nAs long as the people are in this queue, they might be getting message like : \"You are in queue, thanks for patience\". This particular message can be sent using the SSE we talked about.\nThe queue can have logic to let 100 people enter at a time and have their tickets booked and then let another 100 come in. \nThe 100 people can be selected randomly which gives a more fair chance to everyone rather than applying FCFS. This queue can be implemted using REDIS\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    }
  ],
